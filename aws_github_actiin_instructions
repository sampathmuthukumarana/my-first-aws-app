Automated process

1 aws access details should be given to the git hub actions
2.visit settings of the git hub repo then 
  secrets and variables-> Actions
3. click on New repository scerets button and add secrets as follows
  EC2_SSH_KEY
  EC2_HOST - ec2 elastic ip address
  EC2_USER - ubuntu



4. create a local folder .github/workflows and create deployment.yml file there.
 name: Deploy React App to EC2

on:
  push:
    branches:
      - master

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci
      - run: npm run build

      - name: Setup SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.EC2_SSH_KEY }}" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
          ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts

      - name: Deploy build to EC2
        run: |
          rsync -avz dist/ \
          ${{ secrets.EC2_USER }}@${{ secrets.EC2_HOST }}:${{ secrets.EC2_APP_PATH }}
